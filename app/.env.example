# Banco local em SQLite (arquivo criado em app/).
DATABASE_URL=sqlite:///./db.sqlite3

# Em deploy, use o banco gerenciado. Os esquemas postgres:// e postgresql://
# são normalizados para postgresql+psycopg://.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Pool de conexões. Em ambientes com limite baixo, reduza estes valores.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Loga todo SQL emitido (somente desenvolvimento).
DB_ECHO=false

# LLM via LiteLLM. O padrão usa Ollama local; requer `ollama pull qwen2.5:7b`.
LLM_MODEL=ollama/qwen2.5:7b
LLM_API_BASE=http://localhost:11434
# LLM_API_KEY=  # necessário apenas para provedores remotos
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60

# Broker Celery para geração assíncrona de respostas.
CELERY_BROKER_URL=redis://localhost:6379/0
