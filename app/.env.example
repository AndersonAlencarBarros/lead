# Banco local em SQLite (arquivo criado em app/).
DATABASE_URL=sqlite:///./db.sqlite3

# Em deploy, use o banco gerenciado. Os esquemas postgres:// e postgresql://
# são normalizados para postgresql+psycopg://.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Provedor da IA: openrouter | deepseek | ollama.
# O modelo e a base padrão vêm do provedor; LLM_MODEL e LLM_API_BASE sobrescrevem.
LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/liquid/lfm-3-1.7b:free
OPEN_ROUTER_KEY=

# DeepSeek
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=

# Ollama local
# LLM_PROVIDER=ollama
# LLM_MODEL=ollama/qwen2.5
# LLM_API_BASE=http://localhost:11434

# Broker Celery para geração assíncrona de respostas.
CELERY_BROKER_URL=redis://localhost:6379/0
