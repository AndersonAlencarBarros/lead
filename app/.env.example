# Banco local em SQLite (arquivo criado em app/).
DATABASE_URL=sqlite:///./db.sqlite3

# Em deploy, use o banco gerenciado. Os esquemas postgres:// e postgresql://
# são normalizados para postgresql+psycopg://.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Pool de conexões. Em ambientes com limite baixo, reduza estes valores.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Loga todo SQL emitido (somente desenvolvimento).
DB_ECHO=false

# LLM via LiteLLM + OpenRouter. Modelo gratuito LiquidAI LFM3 1.7B.
LLM_MODEL=openrouter/liquid/lfm-3-1.7b:free
# Chave da OpenRouter. Também aceita LLM_API_KEY.
OPEN_ROUTER_KEY=
# Opcional; a OpenRouter usa https://openrouter.ai/api/v1 por padrão.
# LLM_API_BASE=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
# Preços por milhão de tokens para estimar custo. Modelos gratuitos: 0.
LLM_PRECO_ENTRADA_POR_MILHAO=0
LLM_PRECO_SAIDA_POR_MILHAO=0

# Broker Celery para geração assíncrona de respostas.
CELERY_BROKER_URL=redis://localhost:6379/0
